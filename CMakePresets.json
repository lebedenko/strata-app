{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "analysis",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_GLOBAL_AUTOGEN_TARGET": "ON"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_SANITIZERS": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "coverage",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_COVERAGE": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "fuzz",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_FUZZING": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "codeql",
      "inherits": "analysis",
      "binaryDir": "${sourceDir}/build/codeql",
      "cacheVariables": {
        "ENABLE_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 2
    },
    {
      "name": "analysis",
      "configurePreset": "analysis",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "jobs": 2
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "jobs": 2
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "jobs": 2
    },
    {
      "name": "codeql",
      "configurePreset": "codeql",
      "jobs": 2,
      "cleanFirst": true
    }
  ],
  "workflowPresets": [
    {
      "name": "codeql",
      "steps": [
        {
          "type": "configure",
          "name": "codeql"
        },
        {
          "type": "build",
          "name": "codeql"
        }
      ]
    }
  ]
}
